<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+.
  Configures both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the SQLite database in cloud backups -->
        <include domain="database" path="." />
        <!-- Include shared preferences -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Include the SQLite database in device transfers -->
        <include domain="database" path="." />
        <!-- Include shared preferences -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
